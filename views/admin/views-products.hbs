<section>
    <div class="container">
        <div class="row mt-4" style=" padding-left: 74rem;">
            {{!-- <div class=""> --}}
            <a href="/admin/add-product" class="btn btn-success ml-auto "  role="button" >Add-product</a>
            {{!-- </div> --}}
         
        </div>
        <table class="table mt-5">
  <thead>
    <tr>
      <th scope="col">No</th>
      <th scope="col">Title</th>
      <th scope="col">Category</th>
      <th scope="col">Description</th>
      <th>Image</th>
    </tr>
  </thead>
  <tbody>
    {{#each products}}
    <tr>
      <th scope="row">{{inc @index}}</th>
      <td>{{this.Name}}</td>
      <td>{{this.Category}}</td>
      <td>{{this.Description}}</td>
      <td><img style="width : 50px;height:50px" src="/product-images/{{this._id}}.jpg" alt="Product Image"></td>
      {{!-- <td><img src="/product-images/{{this._id}}.jpg" alt="Product Image" style="width: 70px;"></td> --}}
    </tr>
    {{/each}}
  </tbody>
</table>
    </div>
</section>

